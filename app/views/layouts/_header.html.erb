<nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
  <div class="container-fluid">
    <%= link_to 'Contact List', root_url, class: 'navbar-brand' %>

    <button class="navbar-toggler" type="button"
            data-bs-toggle="collapse" data-bs-target="#expanded-menu"
            aria-controls="expanded-menu" aria-expanded="false"
            aria-label="Alternar navegação">
      <span class="navbar-toggler-icon"></span>
    </button>

    <!-- Conteúdo exibido em telas maiores e escondido em telas menores -->
    <div class="collapse navbar-collapse" id="expanded-menu">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        <% if !user_signed_in? %>
          <li class="nav-item">
            <%= link_to 'Nova Conta', new_user_registration_path,
                  class: 'nav-link active' %>
          </li>
        <% end %>
      </ul>

      <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
        <% if !user_signed_in? %>
          <li class="nav-item">
            <%= link_to 'Entrar', new_user_session_path, class: 'nav-link' %>
          </li>
        <% else %>
          <li class="nav-item dropdown">
