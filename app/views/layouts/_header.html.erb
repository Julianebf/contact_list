              </li>
              <li>
                <%= link_to 'Editar', edit_user_path(current_user),
                      class: 'dropdown-item' %>
              </li>
              <li><hr class="dropdown-divider"></li>
              <li>
                <%= link_to 'Sair', destroy_user_session_path,
                      class: 'dropdown-item',
                      data: { turbo_method: :delete } %>
