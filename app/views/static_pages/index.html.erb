<div class="p-5 mb-4 bg-light rounded-3 text-center">
  <div class="container-fluid py-4">
    <h1 class="display-5 fw-bold">Contact List</h1>
    <p class="fs-4 text-muted">Gerencie seus contatos em qualquer lugar!</p>

    <% if user_signed_in? %>
      <%= link_to 'Minha Página', user_contacts_path(current_user),
            class: 'btn btn-primary btn-lg' %>
    <% else %>
      <%= link_to 'Crie Sua Conta', new_user_registration_path,
            class: 'btn btn-primary btn-lg' %>
    <% end %>
  </div>
</div>